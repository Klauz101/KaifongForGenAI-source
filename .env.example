APP_ENV=dev
SECRET_KEY=change-me
FERNET_KEY=generate-with-make-keys
NGO_NAME=Sample Elderly Centre
DEFAULT_LANGUAGE=yue
TIMEZONE=Asia/Hong_Kong

# Providers: mock | azure | tencent | google | openai_compat
STT_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock
TRANSLATE_PROVIDER=mock

# OpenAI-compatible LLM (Azure OpenAI / Qwen via DashScope / Hunyuan / DeepSeek ...)  # verify endpoints in docs
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_CHAT=
LLM_MODEL_EXTRACT=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
AZURE_TTS_VOICE=zh-HK-HiuMaanNeural
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-hongkong
TENCENT_ASR_ENGINE=16k_yue          # verify
TENCENT_TTS_VOICE_TYPE=             # verify Cantonese voice id
GOOGLE_APPLICATION_CREDENTIALS=

STT_MIN_CONFIDENCE=0.55
MAX_ELDER_TURNS=8
MAX_CALL_SECONDS=300
RETAIN_AUDIO=false
AUDIO_RETENTION_HOURS=24
DATA_RETENTION_DAYS=180

HOTLINE_EMERGENCY=999               # TODO: team must verify all numbers before demo
HOTLINE_MENTAL_HEALTH=18111
HOTLINE_SBHK=2389 2222

CORS_ORIGINS=http://localhost:5173

# Added in Phase 2
AZURE_SPEECH_ENDPOINT=              # optional, e.g. https://<resource>.cognitiveservices.azure.com  # verify
AZURE_TTS_VOICE_EN=en-US-JennyNeural
TENCENT_ASR_ENGINE_EN=16k_en        # verify
TENCENT_TTS_VOICE_TYPE_EN=          # verify English voice id

# Phase 4 / 4b / 6
SAFETY_LLM_CLASSIFIER=false         # optional extra red-flag screen; it can only ADD flags
TELEPHONY_PROVIDER=mock             # mock | twilio. Real calls cost money: ask the team first
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=                    # public https URL of this server (e.g. an ngrok URL) so Twilio can reach the webhooks
TELEPHONY_ALLOWED_NUMBERS=          # comma-separated E.164 numbers Kaifong may ever dial (teammates only!). Empty = none
TWILIO_SPEECH_LANGUAGE_YUE=yue-Hant-HK   # verify current support in Twilio's docs
TWILIO_SPEECH_LANGUAGE_EN=en-US
WITHDRAWAL_GRACE_DAYS=30            # personal data is purged this many days after consent is withdrawn
RETENTION_JOB_INTERVAL_HOURS=24
PROVIDER_NO_TRAINING_CONFIRMED=false  # set true once each AI vendor's "do not train on our data" setting is on (PDPO DPP3)
